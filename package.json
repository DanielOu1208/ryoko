{
  "name": "ryoko",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "contracts:emit": "pnpm --filter @ryoko/contracts emit",
    "contracts:test": "pnpm --filter @ryoko/contracts test",
    "contracts:check": "pnpm --filter @ryoko/contracts check",
    "server:dev": "pnpm --dir server dev",
    "server:faux": "MODEL=faux pnpm --dir server dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test"
  }
}
