// Copy this file to Secrets.xcconfig (gitignored) and fill in real values.
// Never commit real keys: the repo is public.
//
// In xcconfig files `//` starts a comment, so write URLs with an empty
// substitution between the slashes: https:/$()/host:port

// Must match APP_TOKEN in server/.env
APP_TOKEN = replace-me

// Local server in the simulator, or the Funnel HTTPS URL / Tailscale IP on a phone
AGENT_BASE_URL = http:/$()/127.0.0.1:8792

SONIOX_API_KEY = replace-me

// Speak (design §8.1). A restricted key (Text to Speech only) with a credit
// limit, and a voice from your account's voices (any multilingual voice; the
// old stock voices only work on accounts made before March 2026). Leave either
// empty to speak with the on-device voice.
ELEVENLABS_API_KEY =
ELEVENLABS_VOICE_ID =
