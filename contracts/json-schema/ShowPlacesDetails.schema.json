{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ryoko.invalid/contracts/ShowPlacesDetails.schema.json",
  "title": "ShowPlacesDetails",
  "type": "object",
  "required": [
    "places"
  ],
  "properties": {
    "places": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "why"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "localName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "One line, home language"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Stop number when this is a plan"
          },
          "when": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "description": "24-hour local time, HH:mm"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 5
    }
  },
  "additionalProperties": false
}
