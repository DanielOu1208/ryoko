# Copy to server/.env (gitignored) and fill in. Never commit real values.

# Server
PORT=8792
# Long random string (e.g. `openssl rand -hex 32`). The same value goes in ios/Config/Secrets.xcconfig.
APP_TOKEN=

# Models (design §6.3). MODEL=faux serves fixtures from contracts/ with no model calls.
MODEL=gmi
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
# Exact model id from the GMI console (empty: deepseek-ai/DeepSeek-V4.1-Flash, thinking off).
GMI_MODEL=
# MODEL can also be provider:modelId. Optional per-skill overrides, as provider or provider:modelId
# (providers: gmi, google), plus thinking per skill (off | minimal | low | medium | high):
# MODEL_PLACE_CARD=gmi:Qwen/Qwen3.8-Flash
# MODEL_DISCOVER=
# MODEL_ALLERGY_CARD=
# MODEL_MIMO=
# MODEL_MIMO_REASONING=off

# Tier 2: Gemini switch (needs a billed project with a spend cap)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Mimo web search (design §6.4)
EXA_API_KEY=

# Soniox: used by spikes now; the server mints short-lived keys in tier 2
SONIOX_API_KEY=

# Safety: model work answers 503 budget_exceeded once a day's spend reaches this (US dollars)
DAILY_BUDGET_USD=15

# Optional knobs (defaults shown)
# RATE_LIMIT_PER_MINUTE=60   # per install id and per client IP
# SSE_PING_SECONDS=15
# LOG_REQUESTS=1             # 0 turns off the one-line access log (it never logs headers or bodies)
# FAUX_PACE=1                # MODEL=faux: scales the scripted Mimo pacing; 0 replays instantly
# FAUX_LATENCY_MS=0          # MODEL=faux: delay before each JSON response, to see loading states
# CACHE_DIR=                 # response cache + budget ledger; default server/.cache (gitignored), "off" = memory only
# SKILL_TIMEOUT_MS=25000     # place-card, discover, allergy-card: time limit per request
# MIMO_TIMEOUT_MS=28000      # Mimo: time limit per message
